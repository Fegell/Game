script/source = "extends Node2D


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	pass


func _on_bilgisayar_ekrani_pressed() -> void:
	pass # Replace with function body.
	$KlavyeSesi.stream = preload(\"res://dragon-studio-keyboard-typing-asmr-356118.wav\")
	$KlavyeSesi.play()
func _input(event: InputEvent) -> void:
	# Eğer farenin sol tuşuna tıklandıysa
	if event is InputEventMouseButton and event.pressed and event.button_index == MOUSE_BUTTON_RIGHT:
		
		# Klavye sesini durdur
		$KlavyeSesi.stop()
		
		# Bilgisayar ekranını kapatmak istersen bu satırın başındaki '#' işaretini kaldır:
		#$ComputerPanel.visible = false
"

